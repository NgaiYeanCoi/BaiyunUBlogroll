---
import type { Article, Source } from '../lib/types';
import ArticleCard from './ArticleCard.astro';
import BlogSidebar from './BlogSidebar.astro';
import Pagination from './Pagination.astro';
import { withBase } from '../client/paths';

interface Props {
  articles: Article[];
  sources: Source[];
  total: number;
  currentPage: number;
  pageCount: number;
}
const { articles, sources, total, currentPage, pageCount } = Astro.props;
const sourceById = new Map(sources.map((source) => [source.id, source]));
const first = total === 0 ? 0 : (currentPage - 1) * 20 + 1;
const last = Math.min(currentPage * 20, total);
---

<div
  class="feed-columns"
  data-feed-app
  data-catalog-url={withBase('catalog.json')}
  data-base-url={withBase()}
  data-static-page={currentPage}
>
  <section aria-labelledby="feed-heading">
    <div class="section-heading">
      <h2 id="feed-heading">文章动态</h2>
      <span class="result-count" aria-live="polite" data-result-count>
        {total} 篇 · {first}–{last}
      </span>
    </div>
    <form class="search-box" role="search" action={withBase()} data-search-form>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="7" />
        <path d="m16.5 16.5 4 4" />
      </svg>
      <label class="visually-hidden" for="article-query">
        搜索文章
      </label>
      <input
        id="article-query"
        name="q"
        type="search"
        placeholder="搜索标题、摘要或博客…"
        autocomplete="off"
        data-query
        disabled
      />
      <button type="button" class="clear-search" data-clear hidden disabled>
        清除
      </button>
    </form>
    <div class="filters" aria-label="按博客筛选">
      <button type="button" class="filter-button" data-source="all" aria-pressed="true" disabled>
        全部博客
      </button>
      {sources.map((source) => (
        <button
          type="button"
          class="filter-button"
          data-source={source.id}
          aria-pressed="false"
          disabled
        >
          {source.name}
        </button>
      ))}
    </div>
    <p class="enhancement-status" data-search-status role="status">
      搜索和筛选将在索引加载后启用。
    </p>
    <div class="feed-list" data-feed-list>
      {articles.map((article) => (
        <ArticleCard article={article} source={sourceById.get(article.sourceId)} />
      ))}
    </div>
    <p class="empty-state" data-empty hidden={total !== 0}>
      暂时没有匹配的文章
    </p>
    <Pagination currentPage={currentPage} pageCount={pageCount} />
  </section>
  <BlogSidebar sources={sources} />
</div>
<script>
  import '../client/feed';
</script>
