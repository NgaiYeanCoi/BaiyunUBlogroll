---
import type { Source } from '../lib/types';
import { withBase } from '../client/paths';
import SourceAvatar from './SourceAvatar.astro';
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

<aside class="feed-aside" aria-label="博客推荐">
  <div class="side-panel">
    <h2>在这里，遇见他们</h2>
    {sources.slice(0, 4).map((source) => (
      <a class="mini-blog" href={source.siteUrl} target="_blank" rel="noopener noreferrer">
        <SourceAvatar source={source} />
        <span>{source.name}</span>
      </a>
    ))}
    <a class="text-link side-link" href={withBase('blogs/')}>
      浏览博客目录 →
    </a>
  </div>
  <div class="side-invite">
    <h2>你也在写博客吗？</h2>
    <p>把你的文字，带到这里。</p>
    <a class="text-link" href={withBase('join/')}>
      了解如何加入 →
    </a>
  </div>
</aside>
